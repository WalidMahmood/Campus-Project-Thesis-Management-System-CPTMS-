@model CPTMS.Models.ViewModels.TeamEligibilityReportViewModel
@{
    ViewData["Title"] = $"Eligibility Check — {Model.Team.Name}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-clipboard2-check-fill me-2"></i>Team Eligibility Report
        </h2>
        <p class="text-muted mb-0">
            Team: <strong>@Model.Team.Name</strong> (@Model.Team.ProjectType &bull; @Model.Team.Department)
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Eligibility" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> All Rules
        </a>
    </div>
</div>

<div class="alert @(Model.Result.IsEligible ? "alert-success" : "alert-danger") rounded-4 p-4 shadow-sm mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center">
            <i class="bi @(Model.Result.IsEligible ? "bi-check-circle-fill" : "bi-exclamation-octagon-fill") fs-2 me-3"></i>
            <div>
                <h5 class="fw-bold mb-1">
                    @(Model.Result.IsEligible ? "Eligible for Submission & Supervisor Assignment" : "Not Yet Eligible")
                </h5>
                <div class="small">Evaluated against rule: <strong>@Model.Result.RuleName</strong></div>
            </div>
        </div>
        <span class="badge @(Model.Result.IsEligible ? "bg-success" : "bg-danger") rounded-pill px-3 py-2 fs-6">
            @(Model.Result.IsEligible ? "PASSED" : "ACTION REQUIRED")
        </span>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 px-4 border-bottom">
        <h5 class="fw-bold mb-0">Criterion-by-Criterion Breakdown</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Criterion</th>
                    <th>Required Threshold</th>
                    <th>Actual Value</th>
                    <th>Result</th>
                    <th class="pe-4">Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Result.Criteria)
                {
                    <tr>
                        <td class="ps-4 fw-semibold">@item.Criterion</td>
                        <td class="small text-muted">@item.RequiredValue</td>
                        <td class="small">@item.ActualValue</td>
                        <td>
                            @if (item.Passed)
                            {
                                <span class="badge bg-success-subtle text-success"><i class="bi bi-check-lg"></i> Pass</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger"><i class="bi bi-x-lg"></i> Fail</span>
                            }
                        </td>
                        <td class="pe-4 small text-muted">@(item.Note ?? "Meets requirement")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
