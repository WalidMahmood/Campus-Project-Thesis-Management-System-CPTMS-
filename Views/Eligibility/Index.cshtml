@model CPTMS.Models.ViewModels.EligibilityDashboardViewModel
@{
    ViewData["Title"] = "Eligibility Rules & Validation";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-patch-check-fill me-2"></i>Eligibility Rules &amp; Validation
        </h2>
        <p class="text-muted mb-0">Configurable department thresholds for team size, semester, CGPA, credits, and project type.</p>
    </div>
    @if (Model.CanManageRules)
    {
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> New Eligibility Rule
        </a>
    }
</div>

@if (Model.IsStudent && Model.CurrentUser != null)
{
    <!-- Student Personal Academic Summary & Live Eligibility Cards -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <h5 class="fw-bold mb-0"><i class="bi bi-person-vcard text-primary me-2"></i>Your Recorded Academic Profile</h5>
                <small class="text-muted">Eligibility is automatically evaluated against active department rules.</small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-light text-dark border px-3 py-2">Dept: <strong>@Model.CurrentUser.Department</strong></span>
                <span class="badge bg-light text-dark border px-3 py-2">Semester: <strong>@(Model.CurrentUser.Semester?.ToString() ?? "N/A")</strong></span>
                <span class="badge bg-light text-dark border px-3 py-2">CGPA: <strong>@(Model.CurrentUser.CGPA?.ToString("F2") ?? "N/A")</strong></span>
                <span class="badge bg-light text-dark border px-3 py-2">Credits: <strong>@(Model.CurrentUser.CompletedCredits?.ToString() ?? "N/A")</strong></span>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var check in new[] { Model.StudentProjectEligibility, Model.StudentThesisEligibility })
            {
                if (check == null) continue;
                <div class="col-lg-6">
                    <div class="border rounded-4 p-4 h-100 @(check.IsEligible ? "border-success bg-success-subtle bg-opacity-10" : "border-danger bg-danger-subtle bg-opacity-10")">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h6 class="fw-bold mb-1">@check.ProjectType Eligibility</h6>
                                <small class="text-muted">Rule: @check.RuleName</small>
                            </div>
                            @if (check.IsEligible)
                            {
                                <span class="badge bg-success rounded-pill px-3 py-2">
                                    <i class="bi bi-check-circle-fill me-1"></i> Eligible
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-2">
                                    <i class="bi bi-x-circle-fill me-1"></i> Not Eligible
                                </span>
                            }
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 bg-white rounded-3 overflow-hidden">
                                <thead class="table-light">
                                    <tr>
                                        <th>Criterion</th>
                                        <th>Required</th>
                                        <th>Your Record</th>
                                        <th class="text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in check.Criteria)
                                    {
                                        <tr>
                                            <td class="fw-medium">@c.Criterion</td>
                                            <td class="text-muted small">@c.RequiredValue</td>
                                            <td class="small">@c.ActualValue</td>
                                            <td class="text-end">
                                                @if (c.Passed)
                                                {
                                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-check-lg"></i> Pass</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger"><i class="bi bi-x-lg"></i> Fail</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Configured Department Rules Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0"><i class="bi bi-sliders text-primary me-2"></i>Configured Department Eligibility Rules</h5>
        <span class="badge bg-primary-subtle text-primary">@Model.Rules.Count rule(s)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Rule Name</th>
                    <th>Type</th>
                    <th>Department</th>
                    <th>Team Size</th>
                    <th>Min Sem</th>
                    <th>Min CGPA</th>
                    <th>Min Credits</th>
                    <th>Same Dept</th>
                    <th>Status</th>
                    @if (Model.CanManageRules)
                    {
                        <th class="text-end pe-4">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Rules.Any())
                {
                    <tr>
                        <td colspan="@(Model.CanManageRules ? 10 : 9)" class="text-center py-4 text-muted">
                            No eligibility rules have been configured yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var rule in Model.Rules)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@rule.Name</td>
                            <td>
                                <span class="badge @(rule.ProjectType == "Thesis" ? "bg-info text-dark" : "bg-primary")">
                                    @rule.ProjectType
                                </span>
                            </td>
                            <td class="small">@rule.Department</td>
                            <td><span class="badge bg-light text-dark border">@rule.MinTeamSize – @rule.MaxTeamSize</span></td>
                            <td>Sem @rule.MinSemester+</td>
                            <td>@rule.MinCgpa.ToString("F2")</td>
                            <td>@rule.MinCompletedCredits cr</td>
                            <td>
                                @(rule.RequireSameDepartment ? "Yes" : "No")
                            </td>
                            <td>
                                @if (rule.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                }
                            </td>
                            @if (Model.CanManageRules)
                            {
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@rule.RuleId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-action="ToggleActive" asp-route-id="@rule.RuleId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(rule.IsActive ? "btn-outline-secondary" : "btn-outline-success") rounded-pill px-3">
                                                @(rule.IsActive ? "Disable" : "Activate")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if ((Model.CanManageRules || User.IsInRole("Supervisor")) && Model.Teams.Any())
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h5 class="fw-bold mb-0"><i class="bi bi-clipboard2-check text-primary me-2"></i>Verify Registered Team Eligibility</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Team Name</th>
                        <th>Project Type</th>
                        <th>Department</th>
                        <th>Accepted Members</th>
                        <th class="text-end pe-4">Audit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var team in Model.Teams)
                    {
                        var acceptedCount = team.Members.Count(m => m.Status == "Accepted");
                        <tr>
                            <td class="ps-4 fw-semibold">@team.Name</td>
                            <td><span class="badge bg-primary-subtle text-primary">@team.ProjectType</span></td>
                            <td class="small">@team.Department</td>
                            <td>@acceptedCount member(s)</td>
                            <td class="text-end pe-4">
                                <a asp-action="CheckTeam" asp-route-id="@team.TeamId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-search me-1"></i> Run Eligibility Check
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
