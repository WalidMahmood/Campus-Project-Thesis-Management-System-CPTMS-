@model CPTMS.Models.ViewModels.EligibilityRuleFormViewModel
@{
    ViewData["Title"] = "Create Eligibility Rule";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-gradient-primary text-white p-4">
                <h4 class="fw-bold mb-1"><i class="bi bi-plus-circle me-2"></i>Create Eligibility Rule</h4>
                <p class="small mb-0 text-white-50">Define academic and team-size thresholds enforced before team formation or submission.</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. CSE Course Project Standard Rule" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ProjectType" class="form-label fw-semibold"></label>
                            <select asp-for="ProjectType" class="form-select">
                                <option value="Project">Project</option>
                                <option value="Thesis">Thesis</option>
                            </select>
                            <span asp-validation-for="ProjectType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Department" class="form-label fw-semibold"></label>
                            <input asp-for="Department" class="form-control" placeholder="Computer Science and Engineering or Any" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MinTeamSize" class="form-label fw-semibold"></label>
                            <input asp-for="MinTeamSize" class="form-control" type="number" min="1" max="10" />
                            <span asp-validation-for="MinTeamSize" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MaxTeamSize" class="form-label fw-semibold"></label>
                            <input asp-for="MaxTeamSize" class="form-control" type="number" min="1" max="10" />
                            <span asp-validation-for="MaxTeamSize" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="MinSemester" class="form-label fw-semibold"></label>
                            <input asp-for="MinSemester" class="form-control" type="number" min="1" max="16" />
                            <span asp-validation-for="MinSemester" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="MinCgpa" class="form-label fw-semibold"></label>
                            <input asp-for="MinCgpa" class="form-control" type="number" step="0.05" min="0" max="4" />
                            <span asp-validation-for="MinCgpa" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="MinCompletedCredits" class="form-label fw-semibold"></label>
                            <input asp-for="MinCompletedCredits" class="form-control" type="number" min="0" max="200" />
                            <span asp-validation-for="MinCompletedCredits" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check mb-2">
                        <input asp-for="RequireSameDepartment" class="form-check-input" />
                        <label asp-for="RequireSameDepartment" class="form-check-label"></label>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Save Rule
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
