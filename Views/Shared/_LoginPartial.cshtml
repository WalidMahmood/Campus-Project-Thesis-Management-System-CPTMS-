@using Microsoft.AspNetCore.Identity
@using CPTMS.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var role = currentUser?.UserRole ?? "User";
    <li class="nav-item me-3">
        <span class="navbar-text text-light">
            <i class="bi bi-person-circle me-1"></i>
            <strong>@(currentUser?.FullName ?? User.Identity?.Name)</strong>
            <span class="badge bg-light text-dark ms-1">@role</span>
        </span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-light btn-sm px-3 rounded-pill">
                <i class="bi bi-box-arrow-right me-1"></i> Logout
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="btn btn-outline-light btn-sm px-3 rounded-pill" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-warning btn-sm px-3 rounded-pill text-dark fw-semibold" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus me-1"></i> Register
        </a>
    </li>
}
</ul>
