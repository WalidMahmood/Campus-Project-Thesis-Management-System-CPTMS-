@model CPTMS.Models.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5">
            <div class="display-1 text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h2 class="fw-bold text-dark">Something Went Wrong</h2>
            <p class="text-muted mt-2 mb-4">
                An unexpected error occurred while processing your request. Please try again or contact the department coordinator if the issue persists.
            </p>
            @if (Model != null && Model.ShowRequestId)
            {
                <div class="alert alert-light border small text-muted mb-4">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </div>
            }
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-house-door me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
