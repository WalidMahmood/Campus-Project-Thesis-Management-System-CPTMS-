@model EditFacultyProfileViewModel
@{
    ViewData["Title"] = "Manage Supervision Profile";
    var maxAssignable = Math.Min(Model.ApprovedCapacityLimit, 20);
}

<div class="mb-4">
    <a asp-action="Availability" class="small text-decoration-none text-muted">
        <i class="bi bi-arrow-left me-1"></i>Back to faculty availability
    </a>
    <h2 class="fw-bold mb-1 mt-1"><i class="bi bi-sliders text-primary me-2"></i>Supervision Capacity &amp; Interests</h2>
    <p class="text-muted mb-0">Declare how many teams you can supervise and the eligibility rules you expect students to meet.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="alert alert-info rounded-3">
            <div class="d-flex flex-wrap gap-4">
                <div>
                    <div class="small text-muted">Approved ceiling (Coordinator)</div>
                    <div class="fs-4 fw-bold text-primary">@Model.ApprovedCapacityLimit</div>
                </div>
                <div>
                    <div class="small text-muted">Current active load</div>
                    <div class="fs-4 fw-bold text-dark">@Model.CurrentSupervisionLoad</div>
                </div>
                <div class="flex-grow-1">
                    <div class="small text-muted">Allowed declared load</div>
                    <div class="fw-semibold">
                        Between @Model.CurrentSupervisionLoad and @Model.ApprovedCapacityLimit team(s)
                    </div>
                    <div class="small text-muted mt-1">
                        Your declared load cannot exceed the approved ceiling or drop below work already in progress.
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-gradient-primary text-white p-4 rounded-top-4">
                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                <p class="small mb-0 text-white-50">@Model.Department</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="EditProfile" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="ResearchInterests" class="form-label fw-semibold text-secondary"></label>
                        <textarea asp-for="ResearchInterests" class="form-control" rows="3"
                                  placeholder="e.g. Software Engineering, Distributed Systems, Machine Learning"></textarea>
                        <div class="form-text">Comma-separated domains help students find you in the directory.</div>
                        <span asp-validation-for="ResearchInterests" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EligibilityConditions" class="form-label fw-semibold text-secondary"></label>
                        <textarea asp-for="EligibilityConditions" class="form-control" rows="3"
                                  placeholder="e.g. Minimum CGPA 3.2, completed CSE370 and CSE470"></textarea>
                        <span asp-validation-for="EligibilityConditions" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MaxSupervisionLoad" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="MaxSupervisionLoad" class="form-control" type="number"
                                   min="@Model.CurrentSupervisionLoad" max="@maxAssignable" />
                            <div class="form-text">
                                Department-approved ceiling: <strong>@Model.ApprovedCapacityLimit</strong>
                            </div>
                            <span asp-validation-for="MaxSupervisionLoad" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-semibold text-secondary">Current Active Load</label>
                            <input value="@Model.CurrentSupervisionLoad" class="form-control" readonly disabled />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-semibold text-secondary">Approved Ceiling</label>
                            <input value="@Model.ApprovedCapacityLimit" class="form-control" readonly disabled />
                        </div>
                    </div>

                    @if (Model.ApprovedCapacityLimit <= 0)
                    {
                        <div class="alert alert-warning small rounded-3">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Your approved ceiling is currently 0. Please contact the Department Coordinator before declaring a supervision load.
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-check2-circle me-1"></i> Save Profile
                        </button>
                        <a asp-action="Availability" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
