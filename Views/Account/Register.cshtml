@model CPTMS.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register Account";
}

<div class="row justify-content-center align-items-center py-4">
    <div class="col-12 col-md-9 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-gradient-primary text-white p-4 text-center">
                <h4 class="mb-1 fw-bold">Create CPTMS Account</h4>
                <p class="small mb-0 text-white-50">Register with your institutional university credentials</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold text-secondary">
                            <i class="bi bi-person me-1"></i> Full Name
                        </label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-secondary">
                            <i class="bi bi-envelope me-1"></i> University Email
                        </label>
                        <input asp-for="Email" class="form-control" placeholder="e.g. name@g.bracu.ac.bd" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <!-- Role -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Role" class="form-label fw-semibold text-secondary">
                                <i class="bi bi-person-badge me-1"></i> Role
                            </label>
                            <select asp-for="Role" class="form-select">
                                <option value="Student">Student</option>
                                <option value="Supervisor">Faculty Supervisor</option>
                                <option value="Evaluator">Faculty Evaluator</option>
                                <option value="Coordinator">Department Coordinator</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <!-- Student / Faculty ID -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="StudentIdNumber" class="form-label fw-semibold text-secondary">
                                <i class="bi bi-upc-scan me-1"></i> ID / Initial
                            </label>
                            <input asp-for="StudentIdNumber" class="form-control" placeholder="e.g. 22201456 or SOSB" />
                            <span asp-validation-for="StudentIdNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Department -->
                    <div class="mb-3">
                        <label asp-for="Department" class="form-label fw-semibold text-secondary">
                            <i class="bi bi-building me-1"></i> Department
                        </label>
                        <input asp-for="Department" class="form-control" readonly value="Computer Science and Engineering" />
                    </div>

                    <div class="row">
                        <!-- Password -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary">
                                <i class="bi bi-lock me-1"></i> Password
                            </label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="At least 6 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary">
                                <i class="bi bi-lock-fill me-1"></i> Confirm Password
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Re-enter password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="d-grid gap-2 mt-3">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-semibold shadow-sm">
                            <i class="bi bi-person-check-fill me-2"></i> Register Account
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-white border-top-0 py-3 text-center">
                <span class="text-muted small">Already registered?</span>
                <a asp-controller="Account" asp-action="Login" class="small fw-bold text-primary text-decoration-none ms-1">
                    Sign in to your account
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
