@model CPTMS.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center align-items-center py-4">
    <div class="col-12 col-md-8 col-lg-5">
        <!-- Brand Header -->
        <div class="text-center mb-4">
            <div class="display-6 fw-bold text-primary mb-1">
                <i class="bi bi-mortarboard-fill me-2"></i>CPTMS
            </div>
            <div class="text-muted fs-6">Campus Project & Thesis Management System</div>
            <div class="small text-secondary">Department of Computer Science and Engineering</div>
        </div>

        <!-- Login Card -->
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-gradient-primary text-white p-4 text-center">
                <h4 class="mb-1 fw-bold">Sign In to Your Account</h4>
                <p class="small mb-0 text-white-50">Enter your institutional credentials to access your dashboard</p>
            </div>
            <div class="card-body p-4 p-md-5">

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                    <!-- Email / ID Field -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-secondary">
                            <i class="bi bi-envelope me-1"></i> Email or Institutional ID
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="Email" class="form-control border-start-0 ps-0" id="inputEmail" placeholder="e.g. student@cptms.edu" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary mb-0">
                                <i class="bi bi-lock me-1"></i> Password
                            </label>
                            <a href="javascript:void(0)" class="small text-decoration-none text-muted" onclick="alert('Password reset workflow is handled by the department coordinator.')">Forgot?</a>
                        </div>
                        <div class="input-group mt-2">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control border-start-0 ps-0" id="inputPassword" type="password" placeholder="••••••••" />
                            <button class="btn btn-outline-secondary border-start-0 bg-light" type="button" id="togglePasswordBtn">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Remember Me Checkbox -->
                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-secondary small">
                            Remember this device for 30 days
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-semibold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </button>
                    </div>

                    <!-- Demo Accounts Quick-Fill Pill Bar for Viva Demonstration -->
                    <div class="demo-login-box mt-4 p-3 bg-light rounded-3 border">
                        <div class="small fw-bold text-secondary mb-2 d-flex align-items-center">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Demo Accounts (Viva / Testing):
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-2 demo-btn" 
                                    data-email="student@cptms.edu" data-pass="Student@123456">
                                <i class="bi bi-mortarboard me-1"></i> Student
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill py-1 px-2 demo-btn" 
                                    data-email="supervisor@cptms.edu" data-pass="Supervisor@123456">
                                <i class="bi bi-person-workspace me-1"></i> Supervisor
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill py-1 px-2 demo-btn" 
                                    data-email="coordinator@cptms.edu" data-pass="Admin@123456">
                                <i class="bi bi-shield-lock me-1"></i> Coordinator
                            </button>
                        </div>
                    </div>

                </form>
            </div>
            <div class="card-footer bg-white border-top-0 py-3 text-center">
                <span class="text-muted small">New student or faculty?</span>
                <a asp-controller="Account" asp-action="Register" class="small fw-bold text-primary text-decoration-none ms-1">
                    Create an institutional account
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Toggle password visibility
        document.getElementById('togglePasswordBtn')?.addEventListener('click', function() {
            const passInput = document.getElementById('inputPassword');
            const icon = document.getElementById('togglePasswordIcon');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        });

        // Demo credentials quick-filler for viva presentations
        document.querySelectorAll('.demo-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('inputEmail').value = this.getAttribute('data-email');
                document.getElementById('inputPassword').value = this.getAttribute('data-pass');
            });
        });
    </script>
}
