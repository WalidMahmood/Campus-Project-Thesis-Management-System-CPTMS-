@model CPTMS.Models.ViewModels.CreateTeamViewModel
@{
    ViewData["Title"] = "Create Project Team";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-gradient-primary text-white p-4">
                <h4 class="fw-bold mb-1"><i class="bi bi-people-fill me-2"></i>Create a New Team</h4>
                <p class="small mb-0 text-white-50">You will automatically become the Team Leader and can invite eligible teammates.</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <div class="alert alert-info small rounded-3 mb-4">
                    <i class="bi bi-shield-check me-2"></i>
                    Your academic profile (Semester, CGPA, Credits, Department) will be checked automatically against active
                    <a asp-controller="Eligibility" asp-action="Index" class="fw-semibold">department eligibility rules</a>.
                </div>

                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Team Alpha — Distributed Systems" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ProjectType" class="form-label fw-semibold"></label>
                            <select asp-for="ProjectType" class="form-select">
                                <option value="Project">Course Project</option>
                                <option value="Thesis">Undergraduate Thesis</option>
                            </select>
                            <span asp-validation-for="ProjectType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Department" class="form-label fw-semibold"></label>
                            <input asp-for="Department" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Briefly describe your target research domain or skills you are looking for in teammates..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Create Team
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
