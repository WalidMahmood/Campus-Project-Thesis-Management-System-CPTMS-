@model TopicSearchViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Topic Discovery";
    var canManage = User.IsInRole("Supervisor") || User.IsInRole("Coordinator");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-search text-primary me-2"></i>Discover Project Topics</h2>
        <p class="text-muted mb-0">Browse faculty-owned project and thesis topics, then filter by domain, skills, and availability.</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle me-1"></i> Create Topic
        </a>
    }
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-lg-4">
                <label asp-for="SearchQuery" class="form-label fw-semibold text-secondary small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-keyboard"></i></span>
                    <input asp-for="SearchQuery" class="form-control" placeholder="Title, description, or skill..." />
                </div>
            </div>
            <div class="col-lg-2">
                <label asp-for="SelectedDomain" class="form-label fw-semibold text-secondary small"></label>
                <select asp-for="SelectedDomain" asp-items="@(new SelectList(Model.AvailableDomains))" class="form-select">
                    <option value="">All domains</option>
                </select>
            </div>
            <div class="col-lg-2">
                <label asp-for="SkillFilter" class="form-label fw-semibold text-secondary small"></label>
                <input asp-for="SkillFilter" class="form-control" placeholder="e.g. Python" />
            </div>
            <div class="col-lg-2">
                <label asp-for="SelectedProjectType" class="form-label fw-semibold text-secondary small"></label>
                <select asp-for="SelectedProjectType" asp-items="@(new SelectList(Model.ProjectTypes))" class="form-select">
                    <option value="">All types</option>
                </select>
            </div>
            <div class="col-lg-2">
                <div class="form-check mb-2">
                    <input asp-for="OnlyAvailable" class="form-check-input" />
                    <label asp-for="OnlyAvailable" class="form-check-label small fw-semibold text-secondary"></label>
                </div>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-funnel me-1"></i> Apply Filters
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                </a>
                <span class="ms-auto align-self-center small text-muted">
                    <strong>@Model.Results.Count</strong> topic(s) found
                </span>
            </div>
        </form>
    </div>
</div>

@if (!Model.Results.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5">
            <div class="icon-circle bg-primary-subtle text-primary mx-auto mb-3">
                <i class="bi bi-inbox fs-4"></i>
            </div>
            <h5 class="fw-bold mb-2">No topics match your filters</h5>
            <p class="text-muted mb-3">Try a broader keyword, clear the domain filter, or include unavailable topics.</p>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">Show all topics</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var topic in Model.Results)
        {
            var progress = topic.Capacity == 0 ? 0 : (int)Math.Round(topic.CurrentAssignedCount * 100.0 / topic.Capacity);
            var summary = topic.Description.Length > 170
                ? topic.Description.Substring(0, 170) + "..."
                : topic.Description;

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <span class="badge bg-primary-subtle text-primary-emphasis">@topic.Domain</span>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@topic.ProjectType</span>
                            </div>
                            @if (topic.IsOpenForApplications)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis">
                                    <i class="bi bi-check-circle me-1"></i>Open
                                </span>
                            }
                            else if (topic.CurrentAssignedCount >= topic.Capacity)
                            {
                                <span class="badge bg-danger-subtle text-danger-emphasis">
                                    <i class="bi bi-x-circle me-1"></i>Full
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                    <i class="bi bi-pause-circle me-1"></i>Closed
                                </span>
                            }
                        </div>

                        <h5 class="fw-bold mb-2">@topic.Title</h5>
                        <p class="text-muted small mb-3">@summary</p>

                        <div class="mb-3">
                            @foreach (var skill in topic.RequiredSkills.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <span class="badge bg-light text-dark border me-1 mb-1">@skill</span>
                            }
                        </div>

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Team capacity</span>
                                <span>@topic.CurrentAssignedCount / @topic.Capacity</span>
                            </div>
                            <div class="progress mb-3" style="height: 7px;">
                                <div class="progress-bar @(topic.CurrentAssignedCount >= topic.Capacity ? "bg-danger" : "bg-primary")"
                                     role="progressbar" style="width: @progress%;"
                                     aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center small text-muted mb-3">
                                <span><i class="bi bi-person-badge me-1"></i>@topic.FacultyOwnerName</span>
                                <span><i class="bi bi-people me-1"></i>@topic.RemainingSlots slot(s) left</span>
                            </div>

                            <a asp-action="Details" asp-route-id="@topic.TopicId" class="btn btn-outline-primary btn-sm rounded-pill w-100">
                                <i class="bi bi-eye me-1"></i> View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
